<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.ThreeCat.Tests</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.ThreeCat.Tests</AssemblyName>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Only the .NET 10 runtime is installed in the development machine; the tests still target
         net9.0 (the Jellyfin 10.11 runtime) and roll forward to the newest installed major. -->
    <RollForward>LatestMajor</RollForward>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- The tests instantiate the plugin configuration and an IApplicationPaths double, so the Jellyfin
         assemblies have to be present at run time, not only at compile time. The plugin excludes their
         runtime assets on purpose (the .zip must not ship Jellyfin), which is why the reference is
         repeated here with the default assets. -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jellyfin.Plugin.ThreeCat\Jellyfin.Plugin.ThreeCat.csproj" />
  </ItemGroup>

</Project>
